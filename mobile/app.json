{
  "expo": {
    "name": "SGS Móvil",
    "slug": "sgs-movil",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b3d66"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Se usa tu ubicación para mostrar el mapa y la ruta hasta el lugar del incidente.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Se comparte tu ubicación con la central durante el turno, incluso con la app en segundo plano.",
        "NSCameraUsageDescription": "Se usa la cámara para tomar fotos y video de evidencia.",
        "NSPhotoLibraryUsageDescription": "Se usa la galería para adjuntar fotos y video.",
        "NSMicrophoneUsageDescription": "Se usa el micrófono para grabar audio de evidencia.",
        "UIBackgroundModes": ["location"]
      },
      "bitcode": false
    },
    "android": {
      "package": "com.sgs.movil",
      "googleServicesFile": "./google-services.json",
      "versionCode": 3,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b3d66"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Se usa tu ubicación para mostrar el mapa y la ruta hasta el lugar del incidente.",
          "locationAlwaysAndWhenInUsePermission": "Se comparte tu ubicación con la central durante el turno, incluso con la app en segundo plano.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Se usa la galería para adjuntar fotos al informe.",
          "cameraPermission": "Se usa la cámara para tomar fotos del incidente."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Se usa la cámara para escanear el código QR de los puntos de control en los rondines."
        }
      ],
      "expo-audio",
      [
        "expo-notifications",
        {
          "color": "#0b3d66"
        }
      ],
      "@config-plugins/react-native-webrtc",
      "expo-font",
      "expo-asset",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "d6052d9c-0653-476f-999a-198b706ee552"
      }
    },
    "owner": "jorgeroncs-team"
  }
}
